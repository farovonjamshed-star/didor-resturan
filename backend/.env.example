# SQLite is used by default for local development.
# For PostgreSQL, use:
# DATABASE_URL=postgresql+psycopg://didor_user:change_me@localhost:5432/didor_db
DATABASE_URL=sqlite:///./didor.db

# Comma-separated frontend origins. Keep localhost entries for local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional secret for future protected admin endpoints. Do not commit a real value.
ADMIN_API_TOKEN=
